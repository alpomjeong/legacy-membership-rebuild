# 시크릿 템플릿 (값 없음) — 실제 비밀은 시크릿 매니저로 주입한다. 평문 커밋 금지. (NFR-SEC-13)
DATABASE_URL=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JUMIN_ENC_KEY=
SMS_API_KEY=
PUSH_VAPID_PRIVATE_KEY=
# 브라우저 CORS 허용 출처(쉼표구분). 운영 필수 — 미설정 시 모든 출처 reflect(개발용).
# 예: https://app.example.com,https://admin.example.com  (네이티브 앱은 Origin 없어 항상 허용)
CORS_ALLOWED_ORIGINS=

# ── DB 백업(온프레미스) ─────────────────────────────────────────────
# 운영(NODE_ENV=production)에서는 기본 활성. 명시적으로 끄려면 false.
BACKUP_ENABLED=
# 백업 산출물 루트(미설정 시 앱폴더\data\backups).
BACKUP_DIR=
# 전체 백업 실행 시각(로컬 0~23시, 기본 3). 그 시각 이후 첫 점검에서 하루 1회 실행 + PC-off 캐치업.
BACKUP_FULL_HOUR=3
# 전체 백업 보존 개수(≈일, 기본 30).
BACKUP_FULL_RETENTION_DAYS=30
# 변경 저널 flush 주기(ms, 기본 5000 = 5초).
BACKUP_DELTA_DEBOUNCE_MS=5000
# 저널 파일 보존 일수(기본 90).
BACKUP_JOURNAL_RETENTION_DAYS=90

# ── 웹 어드민 백업(pg_dump 구동, 옵션 B) ──────────────────────────
# pg_dump/pg_restore 폴더(PATH에 없을 때). 예: C:\Program Files\PostgreSQL\16\bin
PG_BIN=
# 웹 백업 보존일수(기본 30). BACKUP_DIR 공유.
BACKUP_RETENTION_DAYS=30
# 앱 자체 @Cron 자동 백업 켜기(true). 켜면 앱 내장 Node 백업(BACKUP_ENABLED)은 꺼서 이중실행 방지.
BACKUP_PG_SCHEDULE=
