# 네이티브 실행 설정 — infra\native\.env 로 복사해 채우기 (커밋 금지, 주석줄은 # 로 시작)
# 값에 따옴표 붙이지 말 것.

# --- DB ---  (PostgreSQL 설치 시 만든 계정/DB. 비번은 URL 예약문자 / @ : # ? % 금지 → hex 권장)
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@localhost:5432/temple?schema=public

# --- 배포 단계 ---  운영이면 production (기본/미설정 JWT 시크릿이면 부팅 거부)
APP_ENV=production

# --- JWT 시크릿 ---  서로 다른 강한 랜덤값
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- 저장 위치 ---  (미설정 시 앱 폴더\data\... 자동)
# STORAGE_DIR=D:\temple\uploads
# BACKUP_DIR=D:\temple\backups
# 정적 프론트(빌드된 pc-web). Node 가 API 와 같은 포트로 서빙.
# STATIC_DIR=C:\...\buddhist-temple-membership\frontend\dist

# --- 포트 ---  (기본 8080)
PORT=8080

# --- pg_dump/pg_restore 경로 (PATH 에 없으면) ---
# PG_BIN=C:\Program Files\PostgreSQL\16\bin

# --- 자동 백업 스케줄 on ---
BACKUP_PG_SCHEDULE=true

# --- 외부 CORS (네이티브 앱/타 오리진에서 붙을 때만) ---
# CORS_ALLOWED_ORIGINS=https://m.temple.example.com

# --- 주민번호 암호화 키 (강한 랜덤값, 필수) ---
JUMIN_ENC_KEY=
